\newcommand*{\setpagestyle}
{%
	\ignorespaces%
	\pagestyle{myheadings}%
	%
	\makeatletter%
	\renewcommand*{\@oddhead}%	Односторонняя печать
	{%
		\raisebox{0pt}[\headheight][0pt]%	Начало блока
		{%
			\vbox%
			{%
				\hbox to \textwidth%
				{%
					%Oddhead
					\normalfont\strut\thepage\hfil\slshape\rightmark\normalfont%
					%\normalfont\strut\slshape\rightmark\normalfont\hfil\thepage%
				}%
				\hrule%
			}%
		}%
	}%
	%
	\renewcommand*{\@evenhead}%	Двусторонняя печать
	{%
		\raisebox{0pt}[\headheight][0pt]%	Начало блока
		{%
			\vbox%
			{%
				\hbox to \textwidth%
				{%
					%Evenhead
					\normalfont\strut\scshape\fb@TitleBox\normalfont\hfil\thepage\normalfont%
					%\normalfont\strut\thepage\hfil\scshape\fb@TitleBox\normalfont%
				}%
				\hrule
			}%
		}%
	}%
	\makeatother%
}

