\newcommand*{\fb@CustomItem}[3]%
{%
	\mal%
	\def\fb@CustomItem@check{\csname check#1\endcsname}%
	%
	\fb@CustomItem@check(1)%
	\ifthenelse{\boolean{emptydata}}{}%
	{%
		\fb@CustomItem@check(2)%
		%
		\bfseries%
		\ifthenelse{\boolean{emptydata}}%
		{%
			\def\fb@CustomItem@text{\textbf{#2:\ }}%
		}%
		{%
			\def\fb@CustomItem@text{\textbf{#3:\ }}%
		}%
		\fb@preprint[\fb@CustomItem@text]{\fb@CustomItem@text}%
		\normalfont%
	}%
	\mao%
}

\newcommand*{\fb@PrintItem}[2][, ]%	{Имя массива без '\'}[разделитель]
{%
	\ignorespaces%
	\mal%
	%
	\def\fb@PrintItem@cnt{i#2}%
	\def\fb@PrintItem@check{\csname check#2\endcsname}%
	\def\fb@PrintItem@array{\csname #2\endcsname}%
	%
	\newcounter{\fb@PrintItem@cnt}%
	\setcounter{\fb@PrintItem@cnt}{1}%
	\fb@PrintItem@check(\the\value{\fb@PrintItem@cnt})%
	\whiledo{\not\boolean{emptydata}}%
	{%
		\fb@PrintItem@array(\the\value{\fb@PrintItem@cnt})%
		\stepcounter{\fb@PrintItem@cnt}%
		\fb@PrintItem@check(\the\value{\fb@PrintItem@cnt})%
		\ifthenelse{\not\boolean{emptydata}}{#1}{}%
	}%
	%
	\mao%
}

\newcommand*{\fb@PrintItemTwo}[3][\\]%	[разделитель]{Массив имён}{Массив ссылок}
{%
	\ignorespaces%
	\makeatletter%
	%
	\def\fb@PrintItem@count{i#2}%
  \def\fb@PrintItem@ArrayNames@array{\csname #2\endcsname}%
  \def\fb@PrintItem@ArrayNames@check{\csname check#2\endcsname}%
  %
  \def\fb@PrintItem@ArrayLinks@array{\csname #3\endcsname}%
  \def\fb@PrintItem@ArrayLinks@check{\csname check#3\endcsname}%
  %
  \newcounter{\fb@PrintItem@count}%
  \setcounter{\fb@PrintItem@count}{1}%
	\fb@PrintItem@ArrayNames@check(\the\value{\fb@PrintItem@count})%
	\whiledo{\not\boolean{emptydata}}%
	{%
		\fb@PrintItem@ArrayNames@array(\the\value{\fb@PrintItem@count})%
		\fb@PrintItem@ArrayLinks@check(\the\value{\fb@PrintItem@count})%
		\ifthenelse{\boolean{emptydata}}{}%
		{%
			\ (\fb@PrintItem@ArrayLinks@array(\the\value{\fb@PrintItem@count}))%
		}
		\stepcounter{\fb@PrintItem@count}%
		\fb@PrintItem@ArrayNames@check(\the\value{\fb@PrintItem@count})%
		\ifthenelse{\not\boolean{emptydata}}{#1}{}%
	}%
	%
	\makeatother%	
}
