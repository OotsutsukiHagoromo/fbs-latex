\providecommand*{\fbsize}[1]%
%{\renewcommand*{\fb@SizeBox}{#1}}
{%
	\makeatletter% 
	\renewcommand*{\fb@SizeBox}%
	{%
		\makeatletter%
		\@ifundefined{fb@TotPages@getNum}{}%
		{%
			\MODULO{\fb@TotPages@getNum}{10}{\fb@TotPages@mod}
			#1,\ \fb@TotPages@getNum\ страниц%
			\ADD{\fb@TotPages@mod}{1}{\fb@TotPages@mod}%
			\fb@PageSuffix(\fb@TotPages@mod)%
		}%
		\makeatother%
	}%
	\makeatother%
}
	

% \fbpartsnum{Количество частей (считается автоматически)}
