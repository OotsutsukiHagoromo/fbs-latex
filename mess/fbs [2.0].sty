%%	Команды, исользуемые в LaTeX-документе. Например, команда
%%		\fbtitle{Надо назвать поинтереснее}
%%	сообщит пакету, что название фанфика --- "Надо назвать поинтереснее".
%%	Эти команды ничего не выводят на печать --- они дают информацию для команды \maketitle (см. далее).

%	\fbtitle{Название фанфика}
\providecommand*{\fbtitle}[2]
{\renewcommand*{\fb@TitleBox}{#1}\renewcommand*{\fb@FicLinkBox}{#2}}

% \fbauthors{Имя автора(-ов) (c URL-адресами на их страницы)
