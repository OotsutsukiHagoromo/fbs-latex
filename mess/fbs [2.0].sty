%% Печать заголовка
\providecommand{\fbmaketitle}
{%
	\makeatletter%
	\clearpage%
	\pagestyle{empty}%
	\setcounter{page}{-10}
%	\pagenumbering{empty}%
	\rule{0pt}{0pt}%
	\hrule%
	\vskip 0.5in%
	\begin{center}
		\bfseries%
		\huge\fb@TitleBox%
		\ifthenelse{\equal{\fb@FicLinkBox}{}}{}%
		{%
			\par\large\fb@FicLinkBox%
		}%
	\end  {center}
	\par%
	\normalfont%
	\vskip 0.5in
	\hrule%
	\vspace{30pt}%
	%
	%
	% Автор
	%
	\fb@CustomItem{fb@AuthorsBox}{Автор}{Авторы}%
	\fb@PrintItemTwo[\\]{fb@AuthorsBox}{fb@AuthorsLinkBox}

	\fb@CustomItem{fb@TranslatorsBox}{Переводчик}{Переводчики}%
	\fb@PrintItemTwo[\\]{fb@TranslatorsBox}{fb@TranslatorsLinkBox}

	\fb@CustomItem{fb@BetasBox}{Бета}{Беты}%
	\fb@PrintItemTwo{fb@BetasBox}{fb@BetasLinkBox}
	
	\fb@CustomItem{fb@FandomBox}{Фэндом}{Фэндомы}%
	\fb@PrintItem{fb@FandomBox}%

	\checkfb@FandomBox(2)%
	\ifthenelse{\boolean{emptydata}}{}%
	{%
		\ (кроссовер)%
	}%
	
	\fb@CustomItem{fb@CharactersBox}{Основные персонажи}{Основные персонажи}%
	\fb@PrintItem{fb@CharactersBox}

	\fb@CustomItem{fb@PairingBox}{Пэйринг}{Пэйринг}%
	\fb@PrintItem{fb@PairingBox}

	\fb@CustomItem{fb@RatingBox}{Рейтинг}{\Error}%
	\fb@PrintItem{fb@RatingBox}

	\fb@CustomItem{fb@GenresBox}{Жанры}{Жанры}%
	\fb@PrintItem{fb@GenresBox}

	\fb@CustomItem{fb@WarningsBox}{Предупреждения}{Предупреждения}%
	\fb@PrintItem{fb@WarningsBox}

%	\ifthenelse{\equal{\fb@SizeBox}{}}{}%
	{\noindent\textbf{Размер: }\fb@SizeBox\par}

%	\ifthenelse{\equal{\PartsNumBox}{}}{}%
	{\noindent\textbf{Количество частей: }\fb@PartsNumBox\par}

	%\ifthenelse{\equal{\St@usBox}{}}{}%
	{\noindent\textbf{Статус: \fb@StatusBox}\par}

	
	\ifthenelse{\equal{\fb@DescriptionBox}{}}{}%
	{\noindent\textbf{Описание:}\par\fb@DescriptionBox\par}
	
	\ifthenelse{\equal{\fb@DedicationBox}{}}{}%
	{\noindent\textbf{Посвящение:}\par\fb@DedicationBox\par}
	
	\ifthenelse{\equal{\fb@PublicationBox}{}}{}%
	{\noindent\textbf{Публикация на других ресурсах:}\par\fb@PublicationBox\par}
	
	\ifthenelse{\equal{\fb@AuthorsCommentsBox}{}}{}%
	{\noindent\textbf{Примечания автора:}\par\fb@AuthorsCommentsBox\par}

	\clearpage%
	\makeatletter%
	\if@fb@firstCompilation@
		\fb@maketoc
	\fi
	\if@fb@existsSecondSection@
		% Оглавление
		\fb@maketoc
	\fi
	\makeatother%	
	\setcounter{page}{1}%
	\setpagestyle%
	\makeatother%
}



