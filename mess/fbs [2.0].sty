{\readarray{fb@TranslatorsBox}{#1}\readarray{fb@TranslatorsLinkBox}{#2}}

%\fbtransl@ors{Беты}
\providecommand*{\fbbetas}[2]
{\readarray{fb@BetasBox}{#1}\readarray{fb@BetasLinkBox}{#2}}

% \fbfandom{фэндом(-ы)}
\providecommand*{\fbfandom}[1]
{\readarray{fb@FandomBox}{#1}}			

% Персонажи
\providecommand*{\fbcharacters}[1]
{\readarray{fb@CharactersBox}{#1}}

% Пейринг
\providecommand*{\fbpairing}[1]
{\readarray{fb@PairingBox}{#1}}

% \fbr@ing{G / PG-13 / NC-17 / NC-21 / R}
