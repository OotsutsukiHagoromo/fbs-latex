% Подсчёт страниц
\newarray\fb@PageSuffix%
\readarray{fb@PageSuffix}{&а&ы&ы&ы&&&&&&&&&&&&&&&&}%

\providecommand*{\fbsize}[1]%
{%
	\makeatletter% 
	\renewcommand*{\fb@SizeBox}%
	{%
		\makeatletter%
		\@ifundefined{fb@TotPages@getNum}{}%
		{%
			\MODULO{\fb@TotPages@getNum}{10}{\fb@TotPages@temp}
			\ifnum \fb@TotPages@getNum>9
				\ifnum \fb@TotPages@getNum<20
					\let\fb@TotPages@temp=\fb@TotPages@getNum
				\fi
			\fi
			#1,\ \fb@TotPages@getNum\ страниц%
			\ADD{\fb@TotPages@temp}{1}{\fb@TotPages@temp}%
			\fb@PageSuffix(\fb@TotPages@temp)%
		}%
		\makeatother%
	}%
	\makeatother%
}

\renewcommand*{\fb@PartsNumBox}%
{%
	\makeatletter%
	\@ifundefined{fb@TotSections@getNum}{}%
	{%
		\makeatletter%
		\if@fb@existsSecondSection@ \fb@TotSections@getNum \else 1 \fi
%		\ifnum \fb@TotSections@getNum=0 1 \else \fb@TotSections@getNum \fi%
		\makeatother%
	}%
	\makeatother%
}

%% У команды \fbstatus есть один аргумент --- целое число:
%% 1 --- в процессе;
%% 2 --- заморожен;
%% 3 --- завершён.
\providecommand*{\fbstatus}[1]%
{%
	\renewcommand*{\fb@StatusBox}%
	{%
		\ifthenelse{\equal{#1}{1}}%
		{%
			\textcolor{red}{в~процессе}%
		}%
		{%
			\ifthenelse{\equal{#1}{2}}%
			{%
				\textcolor{blue}{заморожен}%
			}%
			{%
				\ifthenelse{\equal{#1}{3}}%
				{%
					\textcolor[rgb]{0,0.58,0}{завершён}%
				}%
				{%
					неверный параметр%
				}%
			}%
		}%
	}%
}

