\newcommand*{\fb@setpagestyle}
{%
	\ignorespaces%
	\pagestyle{myheadings}%
	%
	\makeatletter%
	\renewcommand*{\@oddhead}%	Односторонняя печать
	{%
		\raisebox{0pt}[\headheight][0pt]%	Начало блока
		{%
			\vbox%
			{%
				\hbox to \textwidth%
				{%
					\if@fb@existsSecondSection@
						\normalfont%
						\strut%
						\thepage%
						\hfil%
						\slshape%
						\leftmark%
						\normalfont%
					\else
						% \normalfont
						% \strut
						% \thepage
						% \hfil
						% \scshape
						% \fb@TitleKolontitulBox
						% \normalfont%
						\normalfont
						\strut
						\scshape
						\fb@TitleKolontitulBox
						\normalfont
						\hfil
						\thepage
						\normalfont%
					\fi
					%\normalfont
					%\strut
					%\slshape
					%\rightmark
					%\normalfont
					%\hfil
					%\thepage%
				}%
				\hrule%
			}%
		}%
	}%
	%
	\renewcommand*{\@evenhead}%	Двусторонняя печать
	{%
		\raisebox{0pt}[\headheight][0pt]%	Начало блока
		{%
			\vbox%
			{%
				\hbox to \textwidth%
				{%
					\if@fb@existsSecondSection@
						\normalfont%
						\strut%
						\scshape%
						\fb@TitleKolontitulBox%
						\normalfont%
						\hfil%
						\thepage%
						\normalfont%
					\else
						\normalfont%
						\strut%
						\thepage%
						\hfil%
						\scshape%
						\fb@TitleKolontitulBox%
						\normalfont%
					\fi
				}%
				\hrule
			}%
		}%
	}%
	\makeatother%
}

