\newcommand*{\fb@makeBoxName}[3]{%
	\let\fb@tempname=\undefined
	\let\fb@tempval=\undefined
	\gdef\fb@tempname{\csname #1\endcsname}
	\newcommand{\fb@tempval}{%
		\iffbrussian
			#2%
		\else
			\iffbenglish
				#3%
			\fi
		\fi
	}%
	\iffb@debugmode
		\begingroup
			\sffamily
			\begin{align*}
				\text{fb@tempname} &=%
				\text{%
					\expandafter
					\expandafter
					\expandafter
					\string\fb@tempname
				}
				\\
				\text{%
					fb@tempval%
				} &=
				\text{%
					\fb@tempval
				}
			\end{align*}
		\endgroup
	\fi
	% \iffb@debugmode
