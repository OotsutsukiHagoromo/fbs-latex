\providecommand*{\fbsection}[2][]{%
	\clearpage%
	\thispagestyle{plain}%
	%\rule{0pt}{0pt}%
	%\vspace*{50pt plus 10pt minus 10pt}%
	%\vspace*{6\baselineskip}%
	\vspace*{5\baselineskip}%
	%\hspace*{\parindent}%
	%\section*{#2}%
	\par\noindent
	{%
		\LARGE
		\bfseries
		%\flushleft
		\hyphenpenalty=10000%
		\rule{0pt}{0pt}%
		\hspace{1\parindent}%
		#2%
		\par
	}%
	%\bigskip
	\addvspace{1\baselineskip}%
	\ifthenelse{\equal{#1}{}}{%
		\addcontentsline{toc}{section}{#2}%
		\markboth{#2}{}%
	}{%
		\addcontentsline{toc}{section}{#1}%
		\markboth{#1}{}%
	}%
	\stepcounter{fb@TotSections@cnt}%
}

