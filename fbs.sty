\renewcommand*{\date}[1]{%
	\addvspace{%
		1\baselineskip
		plus
		0.5\baselineskip
		minus
		0.1\baselineskip
	}%
	{%
		\par
		\large
		\bfseries
		#1%
	}%
	\addcontentsline{toc}{subsection}{#1}%
	\markboth{#1}{}%
	\nopagebreak[4]%
	\vspace{0.5\baselineskip minus 0.1\baselineskip}%
	\par
}

