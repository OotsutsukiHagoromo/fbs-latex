\newlength{\journalLength}
\setlength{\journalLength}{0.5\parindent}

\newenvironment{journal}[1][]{%
	\par%
	\addvspace{\bigskipamount}%
	\begingroup
	\sffamily
	\noindent
	%\centering
	\rule{0pt}{0pt}
	\hspace{\journalLength}
	\ifthenelse{\equal{#1}{}}{%
		\hrulefill
	}{%
		%\hbox to 0.7in {\hrulefill}
		%\hspace{\fill}
		\hrulefill
		\hspace{1em}%
		#1%
		\hspace{1em}%
		\hrulefill
		%\hspace{\fill}
		%\hbox to 0.7in {\hrulefill}
	}
	\hspace{\journalLength}
	\rule{0pt}{0pt}
	\par%
	\medskip
	%\sloppy
	%\hyphenpenalty=10000
}{%
	\par%
	\noindent
	\rule{0pt}{0pt}%
	\hspace{\journalLength}
	\hrulefill
	% \hbox to 0.7in {\hrulefill}
	\hspace{\journalLength}
	%\hfill
	\rule{0pt}{0pt}%
	\par
	\addvspace{\bigskipamount}%
	%\normalfont
	\endgroup
}

