\newcommand*{\@phrasetranslate}[3][de]{%
	{\csname text#1 \endcsname{\textit{#2}}}%
	\footnote{%
		%#2 (\textit{#3}) --- #4
		#3 (\textit{%
			%#3
			\if@capital@letter@
